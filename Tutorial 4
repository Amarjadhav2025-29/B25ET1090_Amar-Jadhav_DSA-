#include <stdio.h>
#include <string.h>

#define MAX 30

typedef struct
{
    int emp_no;
    char name[20];
    float salary;
} Employee;

int main()
{
    Employee emp[MAX], temp;
    int n = 0, choice, i, j, key, found;

    do
    {
        printf("\n===== EMPLOYEE DATABASE =====\n");
        printf("1. Create\n");
        printf("2. Display\n");
        printf("3. Search\n");
        printf("4. Modify\n");
        printf("5. Append\n");
        printf("6. Delete\n");
        printf("7. Sort\n");
        printf("8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("\nEnter number of employees: ");
                scanf("%d", &n);

                for (i = 0; i < n; i++)
                {
                    printf("\nEnter details of employee %d\n", i + 1);

                    printf("Employee Number: ");
                    scanf("%d", &emp[i].emp_no);

                    printf("Name: ");
                    scanf(" %[^\n]", emp[i].name);

                    printf("Salary: ");
                    scanf("%f", &emp[i].salary);
                }

                printf("\nDatabase created successfully.\n");
                break;

            case 2:
                if (n == 0)
                {
                    printf("\nDatabase is empty.\n");
                }
                else
                {
                    printf("\n----- Employee Records -----\n");
                    printf("Emp No\tName\t\tSalary\n");

                    for (i = 0; i < n; i++)
                    {
                        printf("%d\t%-15s %.2f\n",
                               emp[i].emp_no,
                               emp[i].name,
                               emp[i].salary);
                    }
                }
                break;

            case 3:
                printf("\nEnter employee number to search: ");
                scanf("%d", &key);

                found = 0;

                for (i = 0; i < n; i++)
                {
                    if (emp[i].emp_no == key)
                    {
                        printf("\nEmployee Found!\n");
                        printf("Employee Number: %d\n", emp[i].emp_no);
                        printf("Name: %s\n", emp[i].name);
                        printf("Salary: %.2f\n", emp[i].salary);

                        found = 1;
                        break;
                    }
                }

                if (!found)
                    printf("\nEmployee not found.\n");

                break;

            case 4:
                printf("\nEnter employee number to modify: ");
                scanf("%d", &key);

                found = 0;

                for (i = 0; i < n; i++)
                {
                    if (emp[i].emp_no == key)
                    {
                        printf("Enter new name: ");
                        scanf(" %[^\n]", emp[i].name);

                        printf("Enter new salary: ");
                        scanf("%f", &emp[i].salary);

                        printf("\nEmployee record modified successfully.\n");

                        found = 1;
                        break;
                    }
                }

                if (!found)
                    printf("\nEmployee not found.\n");

                break;

            case 5:
                if (n >= MAX)
                {
                    printf("\nDatabase is full.\n");
                }
                else
                {
                    printf("\nEnter details of new employee\n");

                    printf("Employee Number: ");
                    scanf("%d", &emp[n].emp_no);

                    printf("Name: ");
                    scanf(" %[^\n]", emp[n].name);

                    printf("Salary: ");
                    scanf("%f", &emp[n].salary);

                    n++;

                    printf("\nEmployee appended successfully.\n");
                }
                break;

            case 6:
                printf("\nEnter employee number to delete: ");
                scanf("%d", &key);

                found = 0;

                for (i = 0; i < n; i++)
                {
                    if (emp[i].emp_no == key)
                    {
                        for (j = i; j < n - 1; j++)
                        {
                            emp[j] = emp[j + 1];
                        }

                        n--;
                        found = 1;

                        printf("\nEmployee deleted successfully.\n");
                        break;
                    }
                }

                if (!found)
                    printf("\nEmployee not found.\n");

                break;

            case 7:
                for (i = 0; i < n - 1; i++)
                {
                    for (j = 0; j < n - i - 1; j++)
                    {
                        if (emp[j].emp_no > emp[j + 1].emp_no)
                        {
                            temp = emp[j];
                            emp[j] = emp[j + 1];
                            emp[j + 1] = temp;
                        }
                    }
                }

                printf("\nRecords sorted by Employee Number.\n");
                break;

            case 8:
                printf("\nExiting program...\n");
                break;

            default:
                printf("\nInvalid choice.\n");
        }

    } while (choice != 8);

    return 0;
}
