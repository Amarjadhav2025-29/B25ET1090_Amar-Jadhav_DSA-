#include <stdio.h>
#include <string.h>

typedef struct student {
    int roll;
    char name[50];
    float sgpa;
} Student;

void create(Student st[], int n) {
    for (int i = 0; i < n; i++) {
        printf("Enter roll, name, and SGPA: ");
        scanf("%d %s %f", &st[i].roll, st[i].name, &st[i].sgpa);
    }
}

void display(Student st[], int n) {
    printf("\nStudent Data:\n");
    for (int i = 0; i < n; i++) {
        printf("%d %s %.2f\n",
               st[i].roll, st[i].name, st[i].sgpa);
    }
}

void modify(Student st[], int n) {
    int roll, i;

    printf("Enter roll number to modify: ");
    scanf("%d", &roll);

    for (i = 0; i < n; i++) {
        if (st[i].roll == roll) {
            printf("Enter new name and SGPA: ");
            scanf("%s %f", st[i].name, &st[i].sgpa);
            printf("Record modified successfully.\n");
            return;
        }
    }

    printf("Student not found.\n");
}

void search(Student st[], int n) {
    int roll, i;

    printf("Enter roll number to search: ");
    scanf("%d", &roll);

    for (i = 0; i < n; i++) {
        if (st[i].roll == roll) {
            printf("Student found: %d %s %.2f\n",
                   st[i].roll, st[i].name, st[i].sgpa);
            return;
        }
    }

    printf("Student not found.\n");
}

void sort(Student st[], int n) {
    Student temp;

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (st[i].roll > st[j].roll) {
                temp = st[i];
                st[i] = st[j];
                st[j] = temp;
            }
        }
    }

    printf("Records sorted by roll number.\n");
}

int main(void) {
    int n, choice;
    Student st[100];

    printf("Enter the number of students: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Invalid number of students.\n");
        return 1;
    }

    create(st, n);

    do {
        printf("\n--- MENU ---\n");
        printf("1. Display\n");
        printf("2. Modify\n");
        printf("3. Search\n");
        printf("4. Sort\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                display(st, n);
                break;

            case 2:
                modify(st, n);
                break;

            case 3:
                search(st, n);
                break;

            case 4:
                sort(st, n);
                break;

            case 5:
                printf("Program ended.\n");
                break;

            default:
                printf("Invalid choice.\n");
        }

    } while (choice != 5);

    return 0;
}
