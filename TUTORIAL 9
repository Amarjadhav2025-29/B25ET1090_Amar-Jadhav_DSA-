#include <stdio.h>

#define MAX 20
#define INF 999

void prims(int cost[MAX][MAX], int n)
{
    int visited[MAX] = {0};
    int i, j, edges = 0;
    int min, u = 0, v = 0;
    int totalCost = 0;

    visited[0] = 1;

    printf("\nMinimum Spanning Tree:\n");

    while (edges < n - 1)
    {
        min = INF;

        for (i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] < min)
                    {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        if (min == INF)
        {
            printf("Graph is disconnected!\n");
            return;
        }

        printf("%d - %d : %d\n", u + 1, v + 1, min);

        totalCost += min;
        visited[v] = 1;
        edges++;
    }

    printf("Total Minimum Cost = %d\n", totalCost);
}

int main()
{
    int cost[MAX][MAX];
    int n, i, j;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    prims(cost, n);

    return 0;
}
